# Copy to backend/.env and adjust. Every setting is optional for local development.

# ── Security (REQUIRED in production) ─────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
READVIBE_JWT_SECRET=change-me
READVIBE_ENVIRONMENT=production
READVIBE_CORS_ORIGINS=["https://your-frontend.example.com"]

# ── Database & storage ────────────────────────────────────────────────────────
# SQLite by default; PostgreSQL example (pip install psycopg[binary]):
# READVIBE_DATABASE_URL=postgresql+psycopg://user:pass@host:5432/readvibe
# READVIBE_STORAGE_DIR=/var/lib/readvibe/storage
READVIBE_MAX_UPLOAD_MB=5120

# ── Google sign-in ────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Add your frontend origins (e.g. http://localhost:5173) under "Authorized JavaScript origins".
# READVIBE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# ── AI (optional) ─────────────────────────────────────────────────────────────
# AI features use free public endpoints (Pollinations, LLM7) with no key, then the built-in local engine.
# To use your own OpenAI-compatible service first (Groq, OpenRouter, Ollama, …):
# READVIBE_LLM_BASE_URL=https://api.groq.com/openai/v1
# READVIBE_LLM_API_KEY=...
# READVIBE_LLM_MODEL=llama-3.3-70b-versatile
# To turn every network LLM off and use only the local engine:
# READVIBE_LLM_ENABLED=false

# ── Misc ──────────────────────────────────────────────────────────────────────
# READVIBE_SEED_DEMO_DATA=false
# READVIBE_RESEARCH_ONLINE=true
# READVIBE_CONTACT_EMAIL=you@example.com
# READVIBE_RATE_LIMIT_PER_MINUTE=600

# ── Persistent database (required on hosts with an ephemeral disk, e.g. Render free) ──
# Any hosted Postgres works (Supabase, Neon…); postgres:// and postgresql:// URLs are accepted.
# READVIBE_DATABASE_URL=postgresql://user:password@host:5432/dbname
