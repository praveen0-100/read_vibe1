**Reading ruler [A]**

```ts
// ruler.ts — a translucent band that snaps to text lines
export function createRuler(host: HTMLElement, getLineRects: () => DOMRect[], color: string, lines = 1) {
  const el = document.createElement('div');
  el.className = 'rv-ruler';                         // position:absolute; left:0; right:0; pointer-events:none
  el.style.background = color;                       // e.g. rgba(255, 214, 0, .25)
  host.appendChild(el);
  let top = 0;
  const place = (y: number) => {
    const rects = getLineRects();
    const r = rects.reduce((best, c) => Math.abs(c.top - y) < Math.abs(best.top - y) ? c : best);
    const origin = host.getBoundingClientRect();
    top = r.top - origin.top;
    el.style.top = `${top}px`;
    el.style.height = `${r.height * lines}px`;
  };
  return { place, followWord: (r: DOMRect) => place(r.top), destroy: () => el.remove() };
}
```

Drag vertically or tap a line to move it (`pointerdown` on the viewport when the ruler is enabled). While TTS plays, call `followWord(rect)` so the ruler tracks the narration, a nice ReadVibe-specific link [R].

