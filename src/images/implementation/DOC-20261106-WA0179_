**Painting** (an overlay layer above the text with `mix-blend-mode: multiply`, `pointer-events: none`):

```ts
// paintMarks.ts
type Box = { left: number; top: number; width: number; height: number };

function lineBoxes(rects: DOMRect[]): Box[] {
  const lines: { l: number; t: number; r: number; b: number }[] = [];
  for (const r of rects) {
    if (r.width < 1) continue;
    const ln = lines.find(x =>
      Math.abs(x.t - r.top) < 3 && Math.abs(x.b - r.bottom) < 3 &&
      r.left <= x.r + 12 && r.right >= x.l - 12);          // adjacency: keeps the two pages of a spread apart
    if (ln) { ln.l = Math.min(ln.l, r.left); ln.r = Math.max(ln.r, r.right); }
    else lines.push({ l: r.left, t: r.top, r: r.right, b: r.bottom });
  }
  return lines.map(x => ({ left: x.l, top: x.t, width: x.r - x.l, height: x.b - x.t }));
}

export function paintAnnotation(layer: HTMLElement, flow: HTMLElement, a: Annotation, hit: Map<string, Box[]>) {
  const s = fromOffset(flow, a.anchor.start), e = fromOffset(flow, a.anchor.end);
  const range = document.createRange();
  range.setStart(s.node, s.offset);
  range.setEnd(e.node, e.offset);
  // layer and flow share the same transformed wrapper, so subtracting the flow's rect gives local coords
  const o = flow.getBoundingClientRect();
  const boxes = lineBoxes([...range.getClientRects()]).map(b => ({ ...b, left: b.left - o.left, top: b.top - o.top }));
  hit.set(a.id, boxes);                                    // used for tap hit-testing (layer ignores pointer events)

  boxes.forEach((b, i) => {
    const d = document.createElement('div');
    d.className = 'rv-mark';
    Object.assign(d.style, { position: 'absolute', left: `${b.left}px`, top: `${b.top}px`, width: `${b.width}px`, height: `${b.height}px` });
    if (a.marks.highlight) d.style.background = PALETTE.highlight[a.marks.highlight as keyof typeof PALETTE.highlight];
    if (a.marks.underline) d.style.boxShadow = `inset 0 -2px 0 ${PALETTE.line[a.marks.underline as keyof typeof PALETTE.line]}`;
    if (a.marks.outline) {
      const c = PALETTE.line[a.marks.outline as keyof typeof PALETTE.line];
      d.style.borderLeft = d.style.borderRight = `2px solid ${c}`;
      if (i === 0) d.style.borderTop = `2px solid ${c}`;
      if (i === boxes.length - 1) d.style.borderBottom = `2px solid ${c}`;
    }
    layer.appendChild(d);
  });
}
// Repaint all marks of the chapter after: pagination, font/margin change, resize, annotation edits.
// For plain highlights you may use the CSS Custom Highlight API where supported — but it cannot draw outlines.
```

**Rules**

- Selecting *None* in a tab removes that style; when all three are none the annotation is deleted (or asks to confirm if it has a note).
- Choosing a colour updates the existing annotation immediately (optimistic UI), then syncs.
- Overlapping annotations: paint in `createdAt` order; the hit-test returns the **topmost** one.

