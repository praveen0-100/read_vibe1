export function applySettings(root: HTMLElement, s: ReaderSettings, systemDark: boolean) {
  const key = s.followSystemTheme ? (systemDark ? 'black' : 'white') : s.pageColor;
  const t = THEME[key];
  root.style.setProperty('--rv-bg', t.bg);
  root.style.setProperty('--rv-fg', t.fg);
  root.style.setProperty('--rv-size', `${s.fontSize}px`);
  root.style.setProperty('--rv-line', String(s.lineHeight));
  root.style.setProperty('--rv-ls', `${s.letterSpacing}em`);
  root.style.setProperty('--rv-margin', `${MARGIN[s.margin] * 100}%`);
  root.style.setProperty('--rv-align', s.align);
