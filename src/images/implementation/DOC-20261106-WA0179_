```ts
// anchors.ts
// Every block element is rendered as <p data-o="START">, START = the block's char offset in the chapter text.
// data-o must be on LEAF blocks only (no nested data-o elements).
export function toOffset(node: Node, nodeOffset: number): number {
  const el = node instanceof Element ? node : node.parentElement!;
  const block = el.closest<HTMLElement>('[data-o]')!;
  const r = document.createRange();
  r.selectNodeContents(block);
  r.setEnd(node, nodeOffset);
  return Number(block.dataset.o) + r.toString().length;
}

export function fromOffset(flow: HTMLElement, off: number): { node: Node; offset: number } {
  const blocks = [...flow.querySelectorAll<HTMLElement>('[data-o]')];
  let lo = 0, hi = blocks.length - 1;                       // last block with data-o <= off
  while (lo < hi) {
    const mid = (lo + hi + 1) >> 1;
    if (Number(blocks[mid].dataset.o) <= off) lo = mid; else hi = mid - 1;
  }
  const block = blocks[lo];
  let rem = off - Number(block.dataset.o);
  const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
  let last: Text | null = null, n: Text | null;
  while ((n = walker.nextNode() as Text | null)) {
    last = n;
    if (rem <= n.data.length) return { node: n, offset: rem };
    rem -= n.data.length;
  }
  return { node: last ?? block, offset: last ? last.data.length : 0 };
}

export function selectionToAnchor(chapterId: string, chapterText: string, sel: Selection): Anchor | null {
  if (sel.rangeCount === 0 || sel.isCollapsed) return null;
  const r = sel.getRangeAt(0);                               // DOM ranges are always start <= end
  const start = toOffset(r.startContainer, r.startOffset);
  const end = toOffset(r.endContainer, r.endOffset);
  return {
    chapterId, start, end,
    exact: chapterText.slice(start, end),
    prefix: chapterText.slice(Math.max(0, start - 32), start),
    suffix: chapterText.slice(end, end + 32),
  };
}

export function firstVisibleOffset(viewport: HTMLElement): number {
  const b = viewport.getBoundingClientRect();
  const x = b.left + 8, y = b.top + 8;
  const pos = (document as any).caretPositionFromPoint?.(x, y);
  if (pos) return toOffset(pos.offsetNode, pos.offset);
  const rg = (document as any).caretRangeFromPoint(x, y) as Range;
  return toOffset(rg.startContainer, rg.startOffset);
}

// If the chapter text is ever re-extracted, find the annotation again.
export function reanchor(text: string, a: Anchor): Anchor | null {
  if (!a.exact) return a;
  const full = (a.prefix ?? '') + a.exact + (a.suffix ?? '');
  let i = text.indexOf(full);
  if (i >= 0) { const s = i + (a.prefix?.length ?? 0); return { ...a, start: s, end: s + a.exact.length }; }
  const from = Math.max(0, a.start - 2000);
  i = text.indexOf(a.exact, from);
  if (i >= 0 && i < a.start + 2000) return { ...a, start: i, end: i + a.exact.length };
  return null;                                               // mark annotation.orphaned = true
}
```

**Acceptance**

- Selecting across the two pages of a spread creates one annotation with one `start`/`end`.
- Changing font size or margins keeps every highlight on the right words.
- With *Annotation Menu* off, no toolbar appears.

